{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoomBoard",
  "version": "0.1.0",
  "identifier": "org.roomboard.app",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "pnpm --filter @roomboard/web build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "RoomBoard", "width": 1280, "height": 800, "dragDropEnabled": true }],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "media-src": "'self' blob: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": { "enable": true, "scope": [] },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "fs": { "scopeDroppedPaths": false }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["roomboard"],
        "name": "Document RoomBoard",
        "description": "Document RoomBoard",
        "mimeType": "application/x-roomboard",
        "role": "Editor"
      },
      {
        "ext": ["rbitem"],
        "name": "Objet RoomBoard",
        "description": "Objet RoomBoard",
        "mimeType": "application/x-roomboard-item",
        "role": "Editor"
      },
      {
        "ext": ["rbpack"],
        "name": "Paquet RoomBoard",
        "description": "Paquet RoomBoard",
        "mimeType": "application/x-roomboard-pack",
        "role": "Editor"
      }
    ]
  }
}
